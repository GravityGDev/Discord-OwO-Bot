# ============================================================
# OwO Bot environment
#
# Local/VPS: copy this file to .env and fill in real values.
# Render: add these keys under Environment, or bulk-import this
# file's contents. render.yaml supplies the non-secret defaults.
# NEVER commit the real .env file, bot tokens, cookies, or DB passwords.
# ============================================================

# ------------------------------------------------------------
# RUNTIME
# Render is pinned to this Node version in render.yaml.
# ------------------------------------------------------------
NODE_ENV=production
NODE_VERSION=24.19.0

# ------------------------------------------------------------
# REQUIRED: Discord
# ------------------------------------------------------------
BOT_TOKEN=

# ------------------------------------------------------------
# REQUIRED: MongoDB runtime
# Atlas or another replica set is required because economy and
# other state-changing commands use MongoDB transactions.
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=owo

# Mongo client tuning
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT=10000

# ------------------------------------------------------------
# OPTIONAL: Discord bot listing
# Leave blank to disable it.
# ------------------------------------------------------------
DBL_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Patreon reward administration
# PATREON_COOKIE is used by the owner-only reward-deliverables
# command. Keep it private; never paste the cookie into Discord.
# PATREON_ACCESS_TOKEN is only needed when a missing Discord ID
# must be resolved through Patreon API v2.
# ------------------------------------------------------------
PATREON_COOKIE=
PATREON_ACCESS_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Legacy OwO service sockets
# Leave blank to disable them.
# ------------------------------------------------------------
STREAM_SOCKET=
STREAM_TOKEN=
SNAIL_SOCKET=
SNAIL_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Metrics / logging
# Leave blank to disable remote InfluxDB logging.
# ------------------------------------------------------------
INFLUXDB_HOST=
INFLUXDB_PASS=

# ------------------------------------------------------------
# OPTIONAL IN DEBUG MODE / REQUIRED BY LEGACY MULTI-SHARD PROD
# config.json currently has debug=true, so these are not needed
# for the initial single-worker deployment on Render.
# ------------------------------------------------------------
SHARDER_HOST=
SHARDER_PASS=
SHARDER_SERVER=

# ------------------------------------------------------------
# OPTIONAL: image-generation service
# Some image-heavy commands need these values. Core bot startup
# does not require them.
# ------------------------------------------------------------
GEN_HOST=
GEN_API_HOST=
GEN_PASS=

# ------------------------------------------------------------
# OPTIONAL / currently disabled legacy Neo4j logging
# ------------------------------------------------------------
NEO4J_HOST=
NEO4J_PASS=

# ============================================================
# ONE-TIME MIGRATION SOURCE VARIABLES
# These are NOT required after the old databases have been
# imported and verified. Do not keep them in the final Render
# runtime environment unless you are actively performing import.
# ============================================================

# MySQL / MariaDB source
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASS=
MYSQL_DATABASE=owo
MONGODB_MIGRATION_BATCH_SIZE=2000

# Redis source
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=

# ============================================================
# OwO Bot environment
# Copy this file to .env on the host and fill in real values.
# NEVER commit the real .env file, bot tokens, cookies, or database passwords.
# ============================================================

# ------------------------------------------------------------
# REQUIRED: Discord
# ------------------------------------------------------------
BOT_TOKEN=

# ------------------------------------------------------------
# REQUIRED: MongoDB runtime
# Atlas or another replica set is recommended/required because
# economy and other state-changing commands use transactions.
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=owo

# Optional Mongo client tuning
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT=10000

# ------------------------------------------------------------
# OPTIONAL: Discord bot listing
# The bot runs without this in local/debug deployments.
# ------------------------------------------------------------
DBL_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Patreon reward administration
# PATREON_COOKIE is used by the owner-only reward-deliverables
# command. Keep it private; never paste the cookie into Discord.
# PATREON_ACCESS_TOKEN is only needed when a missing Discord ID
# must be resolved through Patreon API v2. The v2 token requires
# campaigns.members access.
# ------------------------------------------------------------
PATREON_COOKIE=
PATREON_ACCESS_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Legacy OwO service sockets
# Leave blank to disable them.
# ------------------------------------------------------------
STREAM_SOCKET=
STREAM_TOKEN=
SNAIL_SOCKET=
SNAIL_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Metrics / logging
# Leave blank to disable remote InfluxDB logging.
# ------------------------------------------------------------
INFLUXDB_HOST=
INFLUXDB_PASS=

# ------------------------------------------------------------
# OPTIONAL IN DEBUG MODE / REQUIRED BY LEGACY MULTI-SHARD PROD
# config.json currently has debug=true, so these are not needed
# for the initial single-shard deployment.
# ------------------------------------------------------------
SHARDER_HOST=
SHARDER_PASS=
SHARDER_SERVER=

# ------------------------------------------------------------
# OPTIONAL: image-generation service
# Some presentation-heavy commands such as level-up images need
# these values. The core bot can boot without them.
# ------------------------------------------------------------
GEN_HOST=
GEN_API_HOST=
GEN_PASS=

# ------------------------------------------------------------
# OPTIONAL / currently disabled legacy Neo4j logging
# ------------------------------------------------------------
NEO4J_HOST=
NEO4J_PASS=

# ============================================================
# ONE-TIME MIGRATION SOURCE VARIABLES
# These are NOT required after the old databases have been
# imported and verified. Keep them out of the final runtime env.
# ============================================================

# MySQL / MariaDB source
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASS=
MYSQL_DATABASE=owo
MONGODB_MIGRATION_BATCH_SIZE=2000

# Redis source
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
